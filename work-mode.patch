diff --git a/src/components/WorkApiSetup.tsx b/src/components/WorkApiSetup.tsx
new file mode 100644
index 0000000..83234c4
--- /dev/null
+++ b/src/components/WorkApiSetup.tsx
@@ -0,0 +1,122 @@
+import { memo, useLayoutEffect, useState } from '../lib/teact/teact';
+
+import {
+  buildWorkAppUrl,
+  loadImportantUsernames,
+  loadWorkApiCredentials,
+  parseImportantUsernames,
+  parseWorkApiCredentials,
+  saveImportantUsernames,
+  saveWorkApiCredentials,
+} from '../util/workApiCredentials';
+
+import useLastCallback from '../hooks/useLastCallback';
+
+import Button from './ui/Button';
+import InputText from './ui/InputText';
+
+import styles from './WorkApiSetup.module.scss';
+
+const MY_TELEGRAM_URL = 'https://my.telegram.org/apps';
+const INVALID_CREDENTIALS_TEXT = 'Проверь ключи: api_id — только цифры, api_hash — 32 символа (цифры и буквы a–f)';
+const INVALID_USERNAMES_TEXT = 'Проверь ники: латинские буквы, цифры и _, через запятую, например @username';
+
+// Work mode: setup of Telegram API credentials and always shown people on this device
+const WorkApiSetup = () => {
+  const [initialCredentials] = useState(loadWorkApiCredentials);
+  const [apiId, setApiId] = useState(initialCredentials ? String(initialCredentials.apiId) : '');
+  const [apiHash, setApiHash] = useState(initialCredentials?.apiHash || '');
+  const [usernames, setUsernames] = useState(() => (
+    loadImportantUsernames().map((username) => `@${username}`).join(', ')
+  ));
+  const [error, setError] = useState<string | undefined>();
+
+  // Lets the page transition from the previous screen finish, as `App` does
+  useLayoutEffect(() => {
+    document.documentElement.classList.remove('initial');
+  }, []);
+
+  const handleApiIdChange = useLastCallback((e: React.ChangeEvent<HTMLInputElement>) => {
+    setApiId(e.target.value);
+    setError(undefined);
+  });
+
+  const handleApiHashChange = useLastCallback((e: React.ChangeEvent<HTMLInputElement>) => {
+    setApiHash(e.target.value);
+    setError(undefined);
+  });
+
+  const handleUsernamesChange = useLastCallback((e: React.ChangeEvent<HTMLInputElement>) => {
+    setUsernames(e.target.value);
+    setError(undefined);
+  });
+
+  const handleSubmit = useLastCallback((e: React.FormEvent) => {
+    e.preventDefault();
+
+    const credentials = parseWorkApiCredentials(apiId, apiHash);
+    if (!credentials) {
+      setError(INVALID_CREDENTIALS_TEXT);
+      return;
+    }
+
+    const parsedUsernames = parseImportantUsernames(usernames);
+    if (!parsedUsernames) {
+      setError(INVALID_USERNAMES_TEXT);
+      return;
+    }
+
+    saveWorkApiCredentials(credentials);
+    saveImportantUsernames(parsedUsernames);
+    window.location.replace(buildWorkAppUrl());
+  });
+
+  const handleCancel = useLastCallback(() => {
+    window.location.replace(buildWorkAppUrl());
+  });
+
+  return (
+    <div className={styles.root}>
+      <form className={styles.form} onSubmit={handleSubmit}>
+        <img className={styles.logo} src="./icon-192x192.png" alt="" />
+        <h1 className={styles.title}>Рабочий Telegram</h1>
+        <p className={styles.text}>
+          Вставь ключи приложения с
+          {' '}
+          <a href={MY_TELEGRAM_URL} target="_blank" rel="noopener noreferrer">my.telegram.org</a>
+          {' '}
+          (раздел API development tools). Всё, что здесь указано, хранится только на этом устройстве.
+        </p>
+        <InputText
+          label="api_id"
+          value={apiId}
+          inputMode="numeric"
+          autoComplete="off"
+          onChange={handleApiIdChange}
+        />
+        <InputText
+          label="api_hash"
+          value={apiHash}
+          autoComplete="off"
+          onChange={handleApiHashChange}
+        />
+        <p className={styles.hint}>
+          Чаты с этими людьми видны всегда, на вкладке «Важные». Можно оставить пустым.
+        </p>
+        <InputText
+          label="Всегда показывать: @ник, через запятую"
+          value={usernames}
+          autoComplete="off"
+          onChange={handleUsernamesChange}
+        />
+        {error && <p className={styles.error}>{error}</p>}
+        <Button type="submit" className={styles.button}>Сохранить</Button>
+        {initialCredentials && (
+          <Button className={styles.button} color="translucent" onClick={handleCancel}>Отмена</Button>
+        )}
+      </form>
+    </div>
+  );
+};
+
+export default memo(WorkApiSetup);
