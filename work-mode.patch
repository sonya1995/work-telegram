@@ -0,0 +1,50 @@
+import { PUSH_IDB_STORE } from './browser/idb';
+import { ACCOUNT_SLOT } from './multiaccount';
+import { KNOWN_CHAT_IDS_KEY_PREFIX, WORK_CHAT_IDS_KEY_PREFIX } from './workMode';
+
+const CURRENT_SLOT = ACCOUNT_SLOT || 1;
+const BASELINE_KEY_PREFIX = 'tt-work-known-chats:';
+
+type NewChatsBaseline = {
+  userId: string;
+  chatIds: Set<string>;
+};
+
+let cachedBaseline: NewChatsBaseline | undefined;
+
+// The service worker reads these ids to drop push notifications from non-work chats
+export function saveWorkChatIds(workChatIds: Set<string>) {
+  void PUSH_IDB_STORE.set(`${WORK_CHAT_IDS_KEY_PREFIX}${CURRENT_SLOT}`, Array.from(workChatIds)).catch(() => undefined);
+}
+
+// Chats from the baseline or the chat lists: a push from a person outside them comes from a new chat
+export function saveKnownChatIds(knownChatIds: Set<string>) {
+  void PUSH_IDB_STORE.set(`${KNOWN_CHAT_IDS_KEY_PREFIX}${CURRENT_SLOT}`, Array.from(knownChatIds))
+    .catch(() => undefined);
+}
+
+// The baseline lists chats that existed when this device first loaded all chats. Any private chat
+// outside it is a person who wrote for the first time after that
+export function getNewChatsBaseline(userId: string) {
+  if (cachedBaseline?.userId === userId) return cachedBaseline.chatIds;
+
+  try {
+    const value = localStorage.getItem(`${BASELINE_KEY_PREFIX}${userId}`);
+    if (!value) return undefined;
+
+    cachedBaseline = { userId, chatIds: new Set(JSON.parse(value) as string[]) };
+    return cachedBaseline.chatIds;
+  } catch {
+    return undefined;
+  }
+}
+
+export function saveNewChatsBaseline(userId: string, chatIds: Set<string>) {
+  cachedBaseline = { userId, chatIds };
+
+  try {
+    localStorage.setItem(`${BASELINE_KEY_PREFIX}${userId}`, JSON.stringify(Array.from(chatIds)));
+  } catch {
+    // Without storage the baseline lives until the page reloads
+  }
+}
diff --git a/src/util/workMode.ts b/src/util/workMode.ts
new file mode 100644
index 0000000..204bd89
--- /dev/null
+++ b/src/util/workMode.ts
@@ -0,0 +1,38 @@
+import type { ApiChatFolder } from '../api/types';
+
+// Work mode: the client shows only chats from work folders. A folder counts as a work folder when its title
+// contains the marker emoji, its icon is the marker emoji, or its title is listed in `TG_WORK_FOLDERS`
+const WORK_FOLDER_MARKER = '💼';
+const WORK_FOLDER_TITLES = (import.meta.env.TG_WORK_FOLDERS || '')
+  .split(',')
+  .map(normalizeFolderTitle)
+  .filter(Boolean);
+
+export const WORK_CHAT_IDS_KEY_PREFIX = 'workChatIds:';
+export const KNOWN_CHAT_IDS_KEY_PREFIX = 'knownChatIds:';
+// A synthetic folder with people who wrote for the first time and are not sorted into any folder yet
+export const NEW_CHATS_FOLDER_ID = -100;
+export const NEW_CHATS_FOLDER_TITLE = 'Новые';
+// A synthetic folder with people chosen on this device, always shown in work mode
+export const IMPORTANT_CHATS_FOLDER_ID = -101;
+export const IMPORTANT_CHATS_FOLDER_TITLE = 'Важные';
+export const WORK_MODE_BLOCKED_CHAT_TEXT = 'Это не рабочий чат, он открывается только в обычном Telegram';
+export const WORK_MODE_NO_FOLDERS_TITLE = 'Рабочих папок пока нет';
+export const WORK_MODE_NO_FOLDERS_TEXT = 'Добавь 💼 в название рабочей папки в Telegram, и её чаты появятся здесь';
+
+export function getIsSyntheticFolderId(folderId?: number) {
+  return folderId === NEW_CHATS_FOLDER_ID || folderId === IMPORTANT_CHATS_FOLDER_ID;
+}
+
+export function getIsWorkFolder(folder: Pick<ApiChatFolder, 'title' | 'emoticon'>) {
+  if (folder.emoticon === WORK_FOLDER_MARKER) return true;
+
+  const title = folder.title?.text || '';
+  if (title.includes(WORK_FOLDER_MARKER)) return true;
+
+  return WORK_FOLDER_TITLES.includes(normalizeFolderTitle(title));
+}
+
+function normalizeFolderTitle(title: string) {
+  return title.trim().toLowerCase();
+}
