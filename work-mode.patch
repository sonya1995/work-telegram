diff --git a/src/util/workApiCredentials.ts b/src/util/workApiCredentials.ts
new file mode 100644
index 0000000..aa6c299
--- /dev/null
+++ b/src/util/workApiCredentials.ts
@@ -0,0 +1,104 @@
+// Work mode: Telegram API credentials and the people who are always shown are set on each device and stay
+// in its local storage, so they are never part of the published build
+const CREDENTIALS_STORAGE_KEY = 'tt-work-api-credentials';
+const IMPORTANT_USERNAMES_STORAGE_KEY = 'tt-work-important-usernames';
+const RESET_QUERY = 'reset-keys';
+const SETTINGS_QUERY = 'work-settings';
+const API_ID_REGEX = /^\d{3,12}$/;
+const API_HASH_REGEX = /^[0-9a-f]{32}$/i;
+const USERNAME_REGEX = /^[a-z0-9_]{3,32}$/;
+const USERNAME_SEPARATOR_REGEX = /[\s,;]+/;
+
+export type WorkApiCredentials = {
+  apiId: number;
+  apiHash: string;
+};
+
+let importantUsernames: string[] | undefined;
+
+export function loadWorkApiCredentials(): WorkApiCredentials | undefined {
+  try {
+    const value = localStorage.getItem(CREDENTIALS_STORAGE_KEY);
+    if (!value) return undefined;
+
+    const { apiId, apiHash } = JSON.parse(value) as Partial<WorkApiCredentials>;
+    return parseWorkApiCredentials(String(apiId), String(apiHash));
+  } catch {
+    return undefined;
+  }
+}
+
+export function saveWorkApiCredentials(credentials: WorkApiCredentials) {
+  localStorage.setItem(CREDENTIALS_STORAGE_KEY, JSON.stringify(credentials));
+}
+
+export function parseWorkApiCredentials(apiIdText: string, apiHashText: string): WorkApiCredentials | undefined {
+  const apiId = apiIdText.trim();
+  const apiHash = apiHashText.trim();
+  if (!API_ID_REGEX.test(apiId) || !API_HASH_REGEX.test(apiHash)) return undefined;
+
+  return { apiId: Number(apiId), apiHash: apiHash.toLowerCase() };
+}
+
+// Usernames are kept lowercase and without `@`
+export function loadImportantUsernames() {
+  if (importantUsernames) return importantUsernames;
+
+  try {
+    const value = localStorage.getItem(IMPORTANT_USERNAMES_STORAGE_KEY);
+    importantUsernames = value ? (JSON.parse(value) as string[]) : [];
+  } catch {
+    importantUsernames = [];
+  }
+
+  return importantUsernames;
+}
+
+export function saveImportantUsernames(usernames: string[]) {
+  importantUsernames = usernames;
+  localStorage.setItem(IMPORTANT_USERNAMES_STORAGE_KEY, JSON.stringify(usernames));
+}
+
+export function parseImportantUsernames(text: string): string[] | undefined {
+  const usernames = text.split(USERNAME_SEPARATOR_REGEX)
+    .map((username) => username.replace(/^@/, '').toLowerCase())
+    .filter(Boolean);
+  if (usernames.some((username) => !USERNAME_REGEX.test(username))) return undefined;
+
+  return Array.from(new Set(usernames));
+}
+
+export function getIsWorkSettingsRequested() {
+  return new URL(window.location.href).searchParams.has(SETTINGS_QUERY);
+}
+
+export function buildWorkSettingsUrl() {
+  const url = new URL(window.location.href);
+  url.search = `?${SETTINGS_QUERY}`;
+  url.hash = '';
+
+  return url.href;
+}
+
+export function buildWorkAppUrl() {
+  const url = new URL(window.location.href);
+  url.search = '';
+  url.hash = '';
+
+  return url.href;
+}
+
+// Opening the app with `?reset-keys` asks for new credentials
+export function resetWorkApiCredentialsIfRequested() {
+  const url = new URL(window.location.href);
+  if (!url.searchParams.has(RESET_QUERY)) return;
+
+  try {
+    localStorage.removeItem(CREDENTIALS_STORAGE_KEY);
+  } catch {
+    // Storage can be unavailable, then there is nothing to reset
+  }
+
+  url.searchParams.delete(RESET_QUERY);
+  window.history.replaceState(window.history.state, '', url.href);
+}
